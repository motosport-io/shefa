# Resend transactional email (https://resend.com)
# Used by /api/lead to email new leads to royso@lubinski.co.il
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender address in Resend (e.g. "DLB Motosport <leads@yourdomain.co.il>")
FROM="DLB Motosport <onboarding@resend.dev>"

# Recipient for new leads
TO=royso@lubinski.co.il
